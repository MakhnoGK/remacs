; Git commit messages: the subject, trailers, and the comments git writes below.

(subject) @markup.heading
(prefix (type) @keyword)
(prefix (scope) @type)
(breaking_change (token) @keyword)
(trailer (token) @property)
(trailer (value) @string)
(comment) @comment
(generated_comment) @comment
(generated_comment (title) @keyword)
(change kind: (_) @keyword)
(filepath) @string
(branch) @constant
(scissor) @comment
